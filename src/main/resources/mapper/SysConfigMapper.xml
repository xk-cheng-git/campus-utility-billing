<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.utilitybilling.mapper.SysConfigMapper">

    <resultMap id="BaseResultMap" type="com.campus.utilitybilling.entity.SysConfig">
        <id column="price_id" property="priceId"/>
        <result column="water_price" property="waterPrice"/>
        <result column="electric_price" property="electricPrice"/>
    </resultMap>

    <select id="selectCurrent" resultMap="BaseResultMap">
        SELECT * FROM sys_config WHERE price_id = 1
    </select>

    <update id="update" parameterType="com.campus.utilitybilling.entity.SysConfig">
        UPDATE sys_config
        <set>
            <if test="waterPrice != null">water_price = #{waterPrice},</if>
            <if test="electricPrice != null">electric_price = #{electricPrice},</if>
        </set>
        WHERE price_id = #{priceId}
    </update>

</mapper>
